        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 2,
            "type": "string",
            "description": "Nuevo nombre del producto."
          },
          "sku": {
            "maxLength": 50,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9-]+$",
            "type": "string",
            "description": "Nuevo código único del producto."
          },
          "price": {
            "maximum": 1000000,
            "minimum": 0.01,
            "type": "number",
            "description": "Nuevo precio del producto.",
            "format": "double"
          },
          "categoryId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "description": "Nuevo identificador de la categoría del producto.",
            "format": "int32"
          },
          "isActive": {
            "type": "boolean",
            "description": "Nuevo estado de activación del producto."
          }
        },
        "additionalProperties": false,
        "description": "Datos que pueden modificarse de un producto existente."
      }
