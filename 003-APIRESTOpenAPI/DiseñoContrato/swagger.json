  "components": {
    "schemas": {
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador único de la categoría.",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "description": "Nombre visible de la categoría.",
            "nullable": true
          },
          "description": {
            "type": "string",
            "description": "Descripción de la categoría.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Representa una categoría para clasificar productos."
      },
      "CategoryApiResponse": {
        "type": "object",
        "properties": {
          "isSuccess": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "$ref": "#/components/schemas/Category"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CategoryListApiResponse": {
        "type": "object",
        "properties": {
          "isSuccess": {
            "type": "boolean"
          },
