          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateCategoryRequestDto": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string",
            "description": "Nombre visible de la categoría."
          },
          "description": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "description": "Descripción de la categoría.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Datos necesarios para crear una categoría."
      },
      "CreateProductRequestDto": {
        "required": [
          "name",
          "sku"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 2,
            "type": "string",
            "description": "Nombre del producto."
          },
          "sku": {
            "maxLength": 50,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9-]+$",
            "type": "string",
            "description": "Código único del producto."
          },
          "price": {
            "maximum": 1000000,
            "minimum": 0.01,
            "type": "number",
            "description": "Precio del producto.",
            "format": "double"
          },
          "categoryId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "description": "Identificador de la categoría del producto.",
            "format": "int32"
          },
          "isActive": {
            "type": "boolean",
            "description": "Valor que indica si el producto está activo."
          }
        },
        "additionalProperties": false,
        "description": "Datos necesarios para crear un producto."
      },
      "LoginRequestDto": {
        "required": [
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "minLength": 1,
            "type": "string",
            "description": "Nombre del usuario."
          },
          "password": {
            "minLength": 1,
            "type": "string",
            "description": "Contraseña del usuario."
          }
        },
        "additionalProperties": false,
        "description": "Credenciales utilizadas para solicitar un token de acceso."
      },
      "ObjectApiResponse": {
        "type": "object",
        "properties": {
          "isSuccess": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "nullable": true
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identificador único del producto.",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "description": "Nombre visible del producto.",
            "nullable": true
          },
          "sku": {
            "type": "string",
            "description": "Código único del producto.",
            "nullable": true
          },
          "price": {
            "type": "number",
            "description": "Precio del producto.",
            "format": "double"
          },
          "categoryId": {
            "type": "integer",
            "description": "Identificador de la categoría del producto.",
            "format": "int32"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "isActive": {
            "type": "boolean",
            "description": "Indica si el producto está activo."
          },
          "createdAt": {
            "type": "string",
            "description": "Fecha de creación del registro.",
            "format": "date-time"
          }
        },
        "additionalProperties": false,
        "description": "Representa un producto disponible en el catálogo."
      },
      "ProductApiResponse": {
        "type": "object",
        "properties": {
          "isSuccess": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "data": {
            "$ref": "#/components/schemas/Product"
